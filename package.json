{
  "name": "bitbucket",
  "version": "0.1.0",
  "description": "Bitbucket Cloud pull requests in OpenChamber",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "openchamber-guest-bundle status/main.ts status/main.js && openchamber-guest-bundle panel/main.ts panel/main.js",
    "check": "tsc --noEmit && bun run scripts/check-i18n.ts && openchamber-guest-check"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=2.7.0" },
    "id": "bitbucket",
    "name": "Bitbucket",
    "icon": "icon.svg",
    "contributes": {
      "panel": { "entry": "panel/index.html" },
      "statusSection": {
        "entry": "status/index.html",
        "title": "Bitbucket PR",
        "height": 120,
        "requiresProject": true
      },
      "capabilities": ["files"],
      "integration": {
        "name": "Bitbucket",
        "description": "Bitbucket Cloud: your Atlassian email and an API token with Bitbucket scopes (account, repositories, pull requests, pipelines).",
        "token": {
          "apiOrigin": "https://api.bitbucket.org",
          "scheme": "basic",
          "usernameLabel": "Atlassian email",
          "account": { "path": "/2.0/user", "name": "display_name" }
        }
      }
    }
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.0"
  }
}
